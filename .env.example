# Copie para .env e troque os valores. O .env não vai para o Git.

# Servidor de inferência (Ollama). Na mesma máquina: http://host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11434

# Open WebUI
WEBUI_SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
OPENWEBUI_URL=http://localhost:8080
OPENWEBUI_API_KEY=            # gere em Configurações > Conta > Chaves de API (usada por scripts/sync_skills.py)
MODELO_OLLAMA=qwen2.5:7b      # modelo base dos agentes (precisa suportar chamada de ferramentas)

# Avaliação automática (evals/rodar_agente.py): qualquer servidor com a API /v1/chat/completions
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODELO=qwen2.5:7b
LLM_API_KEY=sem-chave
JUIZ_MODELO=                  # modelo juiz do DeepEval; vazio = pula test_llm_quality.py

# Telemetria (perfil "telemetria" do docker compose)
LANGFUSE_DB_PASSWORD=troque-esta-senha
LANGFUSE_NEXTAUTH_SECRET=troque-por-outro-segredo
LANGFUSE_SALT=troque-por-um-sal
